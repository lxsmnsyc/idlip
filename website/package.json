{
  "name": "website",
  "version": "0.0.0",
  "private": true,
  "description": "The documentation site of idlip",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.ts",
    "preview": "vite preview --outDir dist/client",
    "typecheck": "tsc --noEmit",
    "check:samples": "node scripts/check-samples.ts",
    "test": "vitest run",
    "check:reference": "node scripts/reference/check-exports.ts"
  },
  "dependencies": {
    "@oxc-parser/binding-wasm32-wasi": "0.159.0",
    "idlip": "workspace:*"
  },
  "devDependencies": {
    "@twinkleplop/bash": "0.1.7",
    "@twinkleplop/core": "0.3.1",
    "@twinkleplop/css": "0.1.7",
    "@twinkleplop/json": "0.1.7",
    "@twinkleplop/markdown-it": "0.1.7",
    "@twinkleplop/tsx": "0.1.7",
    "@twinkleplop/typescript": "0.1.7",
    "@types/markdown-it": "14.1.2",
    "@types/node": "^26.6.6",
    "markdown-it": "14.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
